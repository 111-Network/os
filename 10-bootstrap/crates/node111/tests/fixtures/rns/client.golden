# The LXMF helper's Reticulum client config (os/60-transport/README.md §6, §11), rendered
# by 111d. A shared-instance client with no interfaces: it attaches to 111d's rnsd and
# carries no traffic of its own. 0600: it carries the rpc_key.
schema-version = 2

[reticulum]
  share_instance = Yes
  instance_name = 111
  rpc_key = 1111111111111111111111111111111111111111111111111111111111111111
  enable_transport = No

[interfaces]
