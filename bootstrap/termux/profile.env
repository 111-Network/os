# 111 node environment profile (Termux). SOURCED, not executed.
# Install path on device: $PREFIX/var/lib/111/profile.env
# (Written by the provisioner; `111 daemon` and the supervision scripts read it.)
#
# NOTE: variable names must be valid POSIX identifiers — `111_ROOT` is not
# (leading digit), which is why these are NODE111_*.

# Resolve PREFIX defensively: Termux always sets it, but boot contexts differ.
PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
HOME=${HOME:-/data/data/com.termux/files/home}
export PREFIX HOME

# Node root (mirrors the host layout under $PREFIX).
NODE111_ROOT="$PREFIX/var/lib/111"
export NODE111_ROOT

# Payload binary on PATH for maintenance shells (sshd sessions).
PATH="$NODE111_ROOT/current/bin:$PREFIX/bin:$PATH"
export PATH
