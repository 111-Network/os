event: services
data: {"services":[{"actions":["restart","log"],"can_run_here":true,"description":"The node's own AI assistant. It answers questions from the built-in knowledge base and can write proposals for you to accept. It runs on this node; your chats are not sent to the internet.","detail":{"agent_state":"local","binary_present":true,"child":"running","health":{"status":200},"log":"/var/lib/111/agent/111-agent.log","model_id":"qwen3-4b","pid":150,"port":11182},"id":"agent","kb_entry":"models/qwen3-4b.md","kind":"child","name":"111-agent","panel":null,"plain_name":"Local AI agent","reason":"The agent is running and healthy.","reason_code":"healthy","requires":"The standard tier: the 111-agent program in this release.","since":"2026-10-14T22:09:01.702325606Z","state":"live"},{"actions":["restart","log"],"can_run_here":true,"description":"The language model that powers the agent, served by llama-server on this node. It needs the model file and enough memory to run it.","detail":{"binary_present":true,"child":"running","health":{"status":200},"log":"/var/lib/111/agent/llama-server.log","model_file":"stub.gguf","model_id":"qwen3-4b","offer":null,"pid":149,"port":11181},"id":"model","kb_entry":"projects/llama-cpp.md","kind":"child","name":"llama-server","panel":null,"plain_name":"Local model","reason":"The model server is running and healthy.","reason_code":"healthy","requires":"The standard tier: the llama-server program and a model file under models/current.","since":"2026-10-14T22:09:01.702325606Z","state":"live"},{"actions":[],"can_run_here":true,"description":"Reticulum, the mesh network layer that lets this node reach other 111 nodes over any link: Wi-Fi, Ethernet or radio. It runs as the rnsd process.","detail":{"child":"absent","log":null,"peers":null,"python3":true,"transport_state":"no transport"},"id":"transport","kb_entry":"projects/reticulum.md","kind":"child","name":"rnsd","panel":null,"plain_name":"Mesh transport","reason":"Mesh transport is off: python3 is installed, but the Reticulum environment could not be set up.","reason_code":"venv_unavailable","requires":"python3 on this machine (the Reticulum environment is built from it).","since":"2026-10-14T22:09:01.702325606Z","state":"unset"},{"actions":[],"can_run_here":true,"description":"Long-range radio for the mesh. A LoRa board must be bound to a stack before it carries traffic.","detail":{"boards":[],"down_for_sec":null,"driven_by":"meshmud","meshmud_bound":["tcp://127.0.0.1:4403"],"meshtastic":{"open":true,"port":4403,"seen":true},"rnode_bindings":[],"rnsd_running":false,"usb_readable":false},"id":"radio","kb_entry":"projects/meshtastic.md","kind":"detected","name":"RNode / meshtasticd","panel":null,"plain_name":"LoRa radio","reason":"The LoRa board runs Meshtastic, driven by meshmud.","reason_code":"radio_bound_meshtastic","requires":"a mesh stack bound to the board — Reticulum RNode interface or Meshtastic","since":"2026-10-14T22:09:01.702325606Z","state":"live"},{"actions":[],"can_run_here":true,"description":"An offline library of guides and reference pages that ships with every release. The agent reads it to answer questions, and you can browse it here.","detail":{"entries":44,"path":"current/share/kb","payload_present":true,"sha256":"7f76ddb4e0b1b4a1ec08fe240d0f4541bea149cd3d43246a8b47976939d9cac3"},"id":"kb","kind":"builtin","name":"share/kb","panel":null,"plain_name":"Knowledge base","reason":"The knowledge base is installed and verified (44 entries).","reason_code":"verified","requires":"A release that ships the knowledge base (share/kb).","since":"2026-10-14T22:09:01.702325606Z","state":"live"},{"actions":[],"can_run_here":true,"description":"Whether this node can reach the internet right now. Nothing needs setting up here; the node checks once a minute.","detail":{"checked_at":"2026-10-14T22:09:01.692750734Z","error":"io: failed to lookup address information: Temporary failure in name resolution","interval_sec":60,"online":false,"probe_url":"https://static.111.network/204"},"id":"gateway","kind":"detected","name":"wan","panel":null,"plain_name":"Internet gateway","reason":"This node cannot reach the internet right now.","reason_code":"wan_offline","requires":"An internet connection: Wi-Fi, Ethernet or a phone hotspot.","since":"2026-10-14T22:09:01.702325606Z","state":"unset"},{"actions":[],"can_run_here":false,"description":"opencode, a coding agent that can work on software on this node. It runs on hub-class machines that have the opencode tool installed.","detail":{"category":"Relay1","hub":false,"opencode":"/home/kia/.opencode/bin/opencode"},"id":"codeagent","kb_entry":"projects/opencode.md","kind":"detected","name":"opencode","panel":null,"plain_name":"Code agent","reason":"The code agent runs on hub-class nodes only.","reason_code":"not_hub","requires":"A hub-class node (category Hub4A or Hub4B) with opencode installed.","since":"2026-10-14T22:09:01.702325606Z","state":"unset"},{"actions":[],"can_run_here":true,"description":"Sealed messages between your nodes and your contacts. A message goes straight to the other node when it can be reached, or waits with your home hub until it comes back. It runs inside the node; only the two ends can read a message.","detail":{"attributed_links":3,"hub":{"enrolled":false,"reachable":null},"hub_role":true,"members":2,"started":true,"store":{"full":false,"open":true}},"id":"fabric","kind":"builtin","name":"mesh111","panel":null,"plain_name":"Messaging","reason":"This node is a home hub for 2 member nodes.","reason_code":"hub_serving","requires":"A home hub to enroll with, or another 111 node reachable on this network.","since":"2026-10-14T22:09:05.701079686Z","state":"live"},{"actions":["restart"],"can_run_here":true,"description":"Meshtastic's own web client for the Meshtastic board bound to this node, and the list of Meshtastic nodes it hears. What you do in that client goes to your radio and out over Meshtastic; 111 does not see or store it, and 111 itself never transmits on Meshtastic.","detail":{"board":"HELTEC_V3","bound":true,"channel_utilization":null,"child":"running","downlink":{"listening":true,"port":11230},"firmware_version":"2.7.11.abcdef0","log":"/var/lib/111/meshtastic/meshmud.log","meshmud_installed":true,"node_db_present":true,"nodes_heard":3,"port_held_by":null,"running":true,"uplink_lost_sec":null,"usb_uplink":false},"id":"meshtastic","kb_entry":"projects/meshtastic-web.md","kind":"child","name":"meshmud","panel":{"allow":["serial","bluetooth"],"entry":"/","id":"meshtastic","needs_secure_context":false,"optional_hosts":["tiles.openfreemap.org","api.meshtastic.org"],"port":11190,"secure_note":"USB or Bluetooth from this browser works only on the node itself and only for a radio this node has not bound; the bound board is reached through the panel's HTTP connection.","state":{"dropped":0,"enabled":true,"health":"up","listening":true},"title":"Meshtastic"},"plain_name":"Meshtastic","reason":"meshmud is starting.","reason_code":"downlink_pending","requires":"A Meshtastic board identified and bound to this node: plugged in by USB (Linux), or a Wi-Fi board reached by its address.","since":"2026-10-14T22:09:01.702325606Z","state":"starting"}]}

