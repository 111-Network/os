# 111 node rnsd config (Reticulum INI format), rendered by 111d from
# state/interfaces.toml (os/6-transport/README.md §11, renderer v2). Do not
# edit: 111d rewrites it. Mode 0600: it carries the shared-instance rpc_key.
# The schema-version line is the takeover seam: a binary that knows only an
# older version leaves this file alone.
schema-version = 2

[reticulum]
  share_instance = Yes
  instance_name = 111
  rpc_key = 1111111111111111111111111111111111111111111111111111111111111111
  enable_transport = Yes

[interfaces]
  [[Auto Interface]]
    type = AutoInterface
    enabled = yes
    group_id = 111.network
  [[Reticulum Auto Interface]]
    type = AutoInterface
    enabled = yes
  # propagation node: opted in (an LXMF router role the helper carries; no rnsd key)
