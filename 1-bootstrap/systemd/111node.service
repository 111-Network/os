# 111 node daemon — systemd unit.
# Spec: os/1-bootstrap/README.md §Supervision (Linux). systemd/runit are thin
# Restart=always wrappers; the daemon's supervision tree is the supervisor of
# record.
#
# Install-time note (T5): SupplementaryGroups is getent-detected — on systems
# without `uucp` the installer strips that group from this line before install.
# Degraded (container/WSL) installs get a drop-in stripping AmbientCapabilities
# to the container's CapBnd (see systemd/degraded.d/10-container.conf).

[Unit]
Description=111 Network node (111 daemon)
Documentation=https://111.network/docs/node
# network.target only — never network-online (node must come up offline-first).
After=network.target
# Never give up permanently ([Unit] section: valid on systemd 249 and 252+
# alike; bad releases are handled by probation + update-guard, not burst caps).
StartLimitIntervalSec=0

[Service]
Type=notify
ExecStartPre=+/usr/local/bin/111 update-guard
ExecStart=/usr/local/bin/111 daemon
User=node111
SupplementaryGroups=dialout uucp

# Capabilities: ambient set == bounding set (LoRa/netlink/raw sockets/low ports
# when configured). Stripped in the degraded container drop-in.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Sandbox: /var/lib/111 is the ONLY writable tree (StateDirectory=111);
# updates stage/promote inside it. PrivateDevices=false for LoRa hotplug.
ProtectSystem=strict
StateDirectory=111
ProtectHome=true
PrivateTmp=true
PrivateDevices=false

# Restart policy: restart always with a fixed delay (burst caps live in [Unit]).
Restart=always
RestartSec=5

# Watchdog: the daemon heartbeats WATCHDOG=1 unconditionally ≤15s from a
# dedicated task; update windows extend via WATCHDOG_USEC=.
WatchdogSec=30

# Journald namespace (cap lives in journald.111node.conf; no host-global mutation).
LogNamespace=111node

[Install]
WantedBy=multi-user.target
