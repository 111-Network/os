data: {"services":[{"actions":["log"],"can_run_here":true,"description":"The node's own AI assistant. It answers questions from the built-in knowledge base and can write proposals for you to accept. It runs on this node; your chats are not sent to the internet.","detail":{"agent_state":"unavailable","binary_present":true,"child":"running","health":{"status":200},"log":"/tmp/111-smoke.ukRS8d/root/agent/111-agent.log","model_id":"qwen3-4b","pid":40,"port":11182},"id":"agent","kb_entry":"models/qwen3-4b.md","kind":"child","name":"111-agent","plain_name":"Local AI agent","reason":"The agent is running and healthy.","reason_code":"healthy","requires":"The standard tier: the 111-agent program in this release.","since":"2026-10-13T21:43:58.988000498Z","state":"live"},{"actions":["log"],"can_run_here":true,"description":"The language model that powers the agent, served by llama-server on this node. It needs the model file and enough memory to run it.","detail":{"binary_present":true,"child":"running","health":{"status":200},"log":"/tmp/111-smoke.ukRS8d/root/agent/llama-server.log","model_file":"stub.gguf","model_id":"qwen3-4b","offer":null,"pid":39,"port":11181},"id":"model","kb_entry":"projects/llama-cpp.md","kind":"child","name":"llama-server","plain_name":"Local model","reason":"The model server is running and healthy.","reason_code":"healthy","requires":"The standard tier: the llama-server program and a model file under models/current.","since":"2026-10-13T21:44:02.989048135Z","state":"live"},{"actions":[],"can_run_here":true,"description":"Reticulum, the mesh network layer that lets this node reach other 111 nodes over any link: Wi-Fi, Ethernet or radio. It runs as the rnsd process.","detail":{"child":"absent","log":null,"peers":null,"python3":true,"transport_state":"no transport"},"id":"transport","kb_entry":"projects/reticulum.md","kind":"child","name":"rnsd","plain_name":"Mesh transport","reason":"Mesh transport is off: python3 is installed, but the Reticulum environment could not be set up.","reason_code":"venv_unavailable","requires":"python3 on this machine (the Reticulum environment is built from it).","since":"2026-10-13T21:43:58.988000498Z","state":"unset"},{"actions":[],"can_run_here":true,"description":"Long-range radio for the mesh. A LoRa board must be bound to a stack before it carries traffic.","detail":{"boards":[],"down_for_sec":null,"meshtastic":{"open":false,"port":4403,"seen":false},"rnode_bindings":[],"rnsd_running":false,"usb_readable":false},"id":"radio","kb_entry":"projects/reticulum.md","kind":"detected","name":"RNode / meshtasticd","plain_name":"LoRa radio","reason":"No LoRa board is plugged in.","reason_code":"no_radio","requires":"a LoRa board plugged into this node","since":"2026-10-13T21:43:58.988000498Z","state":"unset"},{"actions":[],"can_run_here":true,"description":"An offline library of guides and reference pages that ships with every release. The agent reads it to answer questions, and you can browse it here.","detail":{"entries":23,"path":"current/share/kb","payload_present":true,"sha256":"c9f1d275c7a0b48b704367b4da52f56f29f2e080a8050d774a35b4cedded3d93"},"id":"kb","kind":"builtin","name":"share/kb","plain_name":"Knowledge base","reason":"The knowledge base is installed and verified (23 entries).","reason_code":"verified","requires":"A release that ships the knowledge base (share/kb).","since":"2026-10-13T21:43:58.988000498Z","state":"live"},{"actions":[],"can_run_here":true,"description":"Whether this node can reach the internet right now. Nothing needs setting up here; the node checks once a minute.","detail":{"checked_at":"2026-10-13T21:43:58.984530359Z","error":"io: failed to lookup address information: Temporary failure in name resolution","interval_sec":60,"online":false,"probe_url":"https://static.111.network/204"},"id":"gateway","kind":"detected","name":"wan","plain_name":"Internet gateway","reason":"This node cannot reach the internet right now.","reason_code":"wan_offline","requires":"An internet connection: Wi-Fi, Ethernet or a phone hotspot.","since":"2026-10-13T21:43:58.988000498Z","state":"unset"},{"actions":[],"can_run_here":false,"description":"opencode, a coding agent that can work on software on this node. It runs on hub-class machines that have the opencode tool installed.","detail":{"category":"Relay1","hub":false,"opencode":"/home/kia/.opencode/bin/opencode"},"id":"codeagent","kb_entry":"projects/opencode.md","kind":"detected","name":"opencode","plain_name":"Code agent","reason":"The code agent runs on hub-class nodes only.","reason_code":"not_hub","requires":"A hub-class node (category Hub4A or Hub4B) with opencode on the PATH.","since":"2026-10-13T21:43:58.988000498Z","state":"unset"}]}

